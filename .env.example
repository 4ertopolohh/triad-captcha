# Copy to .env and replace every value marked CHANGE_ME before running Compose.
DJANGO_SECRET_KEY=CHANGE_ME_generate_at_least_50_random_chars
DJANGO_DEBUG=0
DJANGO_SECURE_COOKIES=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_DB=triadcaptcha_demo
POSTGRES_USER=triadcaptcha
POSTGRES_PASSWORD=CHANGE_ME_database_password
DATABASE_URL=postgresql://triadcaptcha:CHANGE_ME_database_password@postgres:5432/triadcaptcha_demo

TRIADCAPTCHA_REDIS_URL=redis://redis:6379/0
TRIADCAPTCHA_SITE_KEY=tc_local_CHANGE_ME_public_installation_id
TRIADCAPTCHA_HMAC_SECRET=CHANGE_ME_32_bytes_or_more_random_server_secret
TRIADCAPTCHA_IDENTIFIER_HMAC_SECRET=CHANGE_ME_separate_32_bytes_or_more_secret
TRIADCAPTCHA_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
TRIADCAPTCHA_DEVELOPMENT_MODE=0
